# Backend configuration (environment variables).
# Spring Boot reads these directly (see backend/src/main/resources/application.properties).
# Usage: copy this file to backend/.env and edit the values there.
# backend/.env is git-ignored - real passwords/secrets must only live in .env, never in git.
# On Windows PowerShell you can also set them per session:  $env:DB_URL = "..."
# or configure them in your IDE run configuration.

# Full JDBC URL of the MySQL database (created automatically if missing)
DB_URL=jdbc:mysql://localhost:3306/hostel_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

DB_USERNAME=root
DB_PASSWORD=
# NOTE: XAMPP users can leave these as-is (root + empty password = XAMPP defaults).

# Server port
SERVER_PORT=8080

# JWT signing secret - generate a long random value for any shared/production use
JWT_SECRET=hostel-project-demo-secret-please-change-me-0123456789

# Token validity in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000

# ---- Admin login (single administrator account) ----
# The admin user is created/refreshed at every backend startup from these values.
# Change the password here, restart the backend, and the new password takes effect.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hostel.local
ADMIN_PASSWORD=admin123
