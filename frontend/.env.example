# API base URL used by the React app.
# In development the Vite dev server proxies /api to the backend (see vite.config.js),
# so this can stay empty. For a production build served separately, set the backend URL:
# VITE_API_URL=http://localhost:8080/api
VITE_API_URL=

# Backend URL the Vite dev-server proxy forwards /api calls to (development only).
VITE_API_PROXY=http://localhost:8080
